# Firebase Web SDK 設定（Firebase コンソール > プロジェクトの設定 > 全般 > マイアプリ）
# dev / prod でプロジェクトを分け、それぞれの値を .env.local に記述する
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase App Check（reCAPTCHA v3 サイトキー）。未設定でも起動はするが本番では必須
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# --- seed スクリプト用（サーバーサイド。コミット禁止） ---
# サービスアカウントJSONのパス、または GOOGLE_APPLICATION_CREDENTIALS を使う
FIREBASE_SERVICE_ACCOUNT=./serviceAccount.json
# 初期アプリ管理者
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
# 初期チーム名
SEED_TEAM_NAME=サンプルチーム
